ackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_connect.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="登录" Foreground="#FFFFFFFF" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><Button Click="OnCampusLogout" x:Name="BtnCampusLogout" AutomationProperties.Name="校园网注销" Height="32" Width="100" Margin="8,0,0,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" Cursor="Hand"><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_disconnect.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="注销" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><TextBlock x:Name="TxtCampusHint" FontSize="12" Foreground="#FF8A94A3" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="620" Text="密码只在本机用 Windows DPAPI 加密保存；点登录时写到 minipc 的 Config.yaml 再执行 bitsrun" /></StackPanel.Children></StackPanel></StackPanel.Children></StackPanel></Border.Child></Border><Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#FFE4E8EF" BorderThickness="1" CornerRadius="4"><Border.Child><TextBox x:Name="TxtCampusLog" FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">点「登录」或「查状态」看结果。 注销会真的断网：注销后 minipc 的校园网会话结束，接在它下面的设备也会一起断。</TextBox></Border.Child></Border></Grid.Children></Grid></TabItem><TabItem AutomationProperties.Name="网址检测"><TabItem.Header><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_internet_connected.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="网址检测" Style="{StaticResource NavText}" /></StackPanel.Children></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.Ch