<?xml version="1.0" encoding="utf-8"?><Window x:Class="NetPanel.MainWindow" Title="网络面板 NetPanel" Height="830" Width="1200" MinWidth="980" MinHeight="640" Icon="/icons/app.png" WindowStartupLocation="CenterScreen" Background="#FFF5F6F8" FontFamily="Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Display" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:n="clr-namespace:NetPanel;assembly=NetPanel" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Window.Resources><Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}"><Setter Property="TextElement.Foreground" Value="#FF1F2430" /></Style><Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}"><Setter Property="Control.Padding" Value="18,8" /><Setter Property="TextElement.FontSize" Value="14" /></Style><Style x:Key="Mono" TargetType="{x:Type TextBlock}"><Setter Property="TextElement.FontFamily" Value="Consolas, 等线" /><Setter Property="TextElement.FontSize" Value="13.2" /><Setter Property="TextElement.Foreground" Value="#FF2B3444" /><Setter Property="TextBlock.TextWrapping" Value="Wrap" /></Style><Style x:Key="PageTitle" TargetType="{x:Type TextBlock}"><Setter Property="TextElement.FontSize" Value="15" /><Setter Property="TextElement.FontWeight" Value="SemiBold" /><Setter Property="TextElement.Foreground" Value="#FF26303F" /><Setter Property="FrameworkElement.VerticalAlignment" Value="Center" /></Style><Style x:Key="Head" TargetType="{x:Type TextBlock}"><Setter Property="TextElement.FontSize" Value="13" /><Setter Property="TextElement.FontWeight" Value="SemiBold" /><Setter Property="TextElement.Foreground" Value="#FF2F6FED" /><Setter Property="FrameworkElement.Margin" Value="0,0,0,6" /></Style><Style x:Key="NavText" TargetType="{x:Type TextBlock}"><Setter Property="TextElement.FontSize" Value="14" /><Setter Property="FrameworkElement.VerticalAlignment" Value="Center" /><Setter Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" /></Style><Style x:Key="NavTab" TargetType="{x:Type TabItem}"><Setter Property="TextElement.Foreground" Value="#FF5B6474" /><Setter Property="FrameworkElement.Height" Value="46" /><Setter Property="FrameworkElement.Margin" Value="8,2,8,2" /><Setter Property="Control.Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}"><Border x:Name="Bd" Background="#00FFFFFF" CornerRadius="6" Padding="14,0,10,0"><Border.Child><Grid><Grid.Children><ContentPresenter ContentSource="Header" VerticalAlignment="Center" /><Rectangle x:Name="Accent" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="#00FFFFFF" HorizontalAlignment="Left" Margin="-14,0,0,0" VerticalAlignment="Center" /></Grid.Children></Grid></Border.Child></Border><ControlTemplate.Triggers><Trigger Property="TabItem.IsSelected" Value="True"><Setter TargetName="Bd" Property="Panel.Background" Value="#FFE8F0FE" /><Setter TargetName="Accent" Property="Shape.Fill" Value="#FF2F6FED" /><Setter Property="TextElement.Foreground" Value="#FF2F6FED" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="UIElement.IsMouseOver" Value="True" /><Condition Property="TabItem.IsSelected" Value="False" /></MultiTrigger.Conditions><Setter TargetName="Bd" Property="Panel.Background" Value="#FFF1F5FC" /></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="NavTabControl" TargetType="{x:Type TabControl}"><Setter Property="Control.Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabControl}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="172" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.Children><Border Background="#FFFAFBFD" BorderBrush="#FFE7EAF0" BorderThickness="1" CornerRadius="6" Padding="0,10"><Border.Child><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" /></Border.Child></Border><Border Grid.Column="1" Background="#FFFFFFFF" Margin="10,0,0,0" BorderBrush="#FFE7EAF0" BorderThickness="1" CornerRadius="6" Padding="16"><Border.Child><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" /></Border.Child></Border></Grid.Children></Grid></ControlTemplate></Setter.Value></Setter></Style></Window.Resources><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.Children><Grid Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.Children><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Children><TextBlock Text="网络面板" FontSize="22" FontWeight="SemiBold" /><Border Background="#FFE8F0FE" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"><Border.Child><TextBlock x:Name="TxtBadge" Text="v1.29.2 · 日志设置" FontSize="11.5" Foreground="#FF2F6FED" /></Border.Child></Border></StackPanel.Children></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><StackPanel.Children><Image x:Name="ImgDotLink" Source="/icons/dot_wait.png" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="TxtHint" Text="数据目录已就绪" Foreground="#FF7C8798" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Grid.Children></Grid><TabControl SelectionChanged="OnNavChanged" x:Name="NavTabs" Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource NavTabControl}" TabStripPlacement="Left" ItemContainerStyle="{StaticResource NavTab}"><TabControl.Items><TabItem AutomationProperties.Name="状态"><TabItem.Header><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_online_state.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="状态" Style="{StaticResource NavText}" /></StackPanel.Children></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.Children><Grid Row="0" Margin="0,0,0,12"><Grid.Children><TextBlock Style="{StaticResource PageTitle}" Text="运行状态" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><StackPanel.Children><Button Click="OnWatchInstall" x:Name="BtnWatchInstall" AutomationProperties.Name="安装看门狗" Height="32" Padding="14,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" FontSize="13.5" Cursor="Hand" ToolTip="把看门狗装到远端（只需输一次 sudo 密码）：每分钟检查 AP 是否假在线"><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/shield.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="安装看门狗" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><Button Click="OnWatchRestart" x:Name="BtnWatchRestart" AutomationProperties.Name="重启 AP" Height="32" Padding="14,0" Margin="8,0,0,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" FontSize="13.5" Cursor="Hand" ToolTip="让远端重启无线 AP 连接（3~5 秒，不需要密码；需先装看门狗）"><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/power.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="重启 AP" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><Button Click="OnWatchAuto" x:Name="BtnWatchAuto" AutomationProperties.Name="自动执行开关" Height="32" Padding="12,0" Margin="8,0,0,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" FontSize="13.5" Cursor="Hand" ToolTip="自动执行：开=检测到假在线自己重启 AP；关=只记录不动手"><StackPanel Orientation="Horizontal"><StackPanel.Children><Image x:Name="ImgWatchSwitch" Source="/icons/switch_off.png" Width="42" Height="22" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="TxtWatchAuto" Text="自动执行：关" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><Button Click="OnDiagnose" x:Name="BtnDiagnose" AutomationProper