el.Children></StackPanel></ScrollViewer><Border Grid.Column="1" BorderBrush="#FFDFE3EA" BorderThickness="1,0,0,0" Padding="18,0,0,0"><Border.Child><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel.Children><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><StackPanel.Children><Image x:Name="ImgDotMini" Source="/icons/dot_wait.png" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="远端软路由" FontSize="13" FontWeight="SemiBold" Foreground="#FF2F6FED" /></StackPanel.Children></StackPanel><StackPanel x:Name="StpMini" /><Border x:Name="BdMode" Background="#FFFAFBFD" BorderBrush="#FFE4E8EF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0"><Border.Child><StackPanel><TextBlock Text="软路由模式" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF5B6474" /><TextBlock x:Name="TxtModeNow" Text="当前：—" FontSize="12" Foreground="#FF7C8798" Margin="0,4,0,8" TextWrapping="Wrap" /><WrapPanel><Button Click="OnSwitchRouter" x:Name="BtnSwitchRouter" AutomationProperties.Name="切到软路由" Height="30" Padding="12,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" FontSize="12.5" Cursor="Hand" ToolTip="minipc 变成软路由：eno1 接校园网当 WAN，wlp2s0 开热点当 LAN"><TextBlock Text="切到软路由" /></Button><Button Click="OnSwitchHotspot" x:Name="BtnSwitchHotspot" AutomationProperties.Name="回滚到热点" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#FFFFF1F0" Foreground="#FFC0392B" BorderThickness="1" BorderBrush="#FFF3C9C4" FontSize="12.5" Cursor="Hand" ToolTip="退回热点模式：关 AP、删 NAT、有线恢复 autoconnect"><TextBlock Text="回滚到热点" Foreground="#FFC0392B" /></Button><Button Click="OnHarden" x:Name="BtnHarden" AutomationProperties.Name="加固伪装" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" FontSize="12.5" Cursor="Hand" ToolTip="主机名随机化 / 关 mDNS / TTL 等加固"><TextBlock Text="加固伪装" /></Button></WrapPanel><TextBlock x:Name="TxtModeHint" FontSize="11.5" Foreground="#FF9AA3B2" Margin="0,8,0,0" TextWrapping="Wrap" Text="切模式会断网重连：切到软路由前，主力机要先注销校园网；回滚前，主力机要先开热点。" /></StackPanel></Border.Child></Border><TextBlock x:Name="TxtNicHint" FontSize="12" Foreground="#FF2F8F5B" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="每 1 分钟自动刷新；插了新网卡点上方「刷新」会一起查出来，平时不轮询" Foreground="#FF9AA3B2" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel.Children></StackPanel></ScrollViewer></Border.Child></Border></Grid.Children></Grid></Grid.Children></Grid></TabItem><TabItem AutomationProperties.Name="校园网"><TabItem.Header><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_security_policy.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="校园网" Style="{StaticResource NavText}" /></StackPanel.Children></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.Children><DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False"><DockPanel.Children><Button Click="OnCampusStatus" x:Name="BtnCampusStatus" DockPanel.Dock="Right" AutomationProperties.Name="查校园网状态" Height="32" Padding="14,0" Background="#FFEEF2F8" BorderThickness="1" BorderBrush="#FFD5DBE5" Cursor="Hand" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><StackPanel.Children><Image Source="/icons/n_conn_state.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="查状态" VerticalAlignment="Center" /></StackPanel.Children></StackPanel></Button><TextBlock Style="{StaticResource PageTitle}" Text="校园网登录" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Left" Text="srun 认证 · 由 minipc 执行" FontSize="12" Foreground="#FF9AA3B2" VerticalAlignment="Center" Margin="12,0,0,0" /></DockPanel.Children></DockPanel><Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE4E8EF" BorderThickness="1" CornerRadius="4" Padding="16,14,16,14" Margin="0,0,0,10"><Border.Child><StackPan