<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NetPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:n="clr-namespace:NetPanel;assembly=NetPanel"
    xmlns:ctrl="clr-namespace:NetPanel.Controls"
    Title="网络面板 NetPanel"
    Width="1200"
    Height="830"
    MinWidth="1120"
    MinHeight="640"
    Background="#FFF5F7FB"
    FontFamily="Microsoft YaHei UI"
    FontSize="13"
    Icon="/icons/ui_layout-dashboard_24_dark.png"
    TextOptions.TextFormattingMode="Display"
    WindowStartupLocation="CenterScreen">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Children>
            <Grid Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.Children>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel.Children>
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="网络面板" />
                            <Border
                                Margin="12,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="#FFE8F3FF"
                                CornerRadius="4">
                                <Border.Child>
                                    <TextBlock
                                        x:Name="TxtBadge"
                                        FontSize="11.5"
                                        Foreground="#FF2D8CFF"
                                        Text="日志设置" />
                                </Border.Child>
                            </Border>
                        </StackPanel.Children>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel.Children>
                            <Image
                                x:Name="ImgDotLink"
                                Width="12"
                                Height="12"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Source="/icons/dot_wait.png" />
                            <TextBlock
                                x:Name="TxtHint"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextT3}"
                                Text="数据目录已就绪" />
                        </StackPanel.Children>
                    </StackPanel>
                </Grid.Children>
            </Grid>
            <TabControl
                x:Name="NavTabs"
                Grid.Row="1"
                Margin="0,14,0,0"
                ItemContainerStyle="{StaticResource NavTab}"
                SelectionChanged="OnNavChanged"
                Style="{StaticResource NavTabControl}"
                TabStripPlacement="Left">
                <TabControl.Items>
<TabItem AutomationProperties.Name="状态">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Children>
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Source="/icons/ui_layout-dashboard_32_dark.png" />
                                    <TextBlock Style="{StaticResource NavText}" Text="状态" />
                                </StackPanel.Children>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.Children>
                                <Grid Margin="0,0,0,12" Row="0">
                                    <Grid.Children>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Source="/icons/ui_activity_24_blue.png" />
                                            <TextBlock Style="{StaticResource PageTitle}" Text="运行状态" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <StackPanel.Children>
                                                <Button Style="{StaticResource BtnSecondary}"
                                                    x:Name="BtnWatchInstall"
                                                    Height="32"
                                                    Padding="14,0"
                                                    AutomationProperties.Name="安装看门狗"
                                                    Click="OnWatchInstall"
                                                    Cursor="Hand"
                                                    FontSize="13.5"
                                                    ToolTip="把看门狗装到远端（只需输一次 sudo 密码）：每分钟检查 AP 是否假在线">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                Width="15"
                                                                Height="15"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/ui_shield_24_dark.png" />
                                                            <TextBlock VerticalAlignment="Center" Text="安装看门狗" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnSecondary}"
                                                    x:Name="BtnWatchRestart"
                                                    Height="32"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    AutomationProperties.Name="重启 AP"
                                                    Click="OnWatchRestart"
                                                    Cursor="Hand"
                                                    FontSize="13.5"
                                                    ToolTip="让远端重启无线 AP 连接（3~5 秒，不需要密码；需先装看门狗）">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                Width="15"
                                                                Height="15"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/ui_power_24_dark.png" />
                                                            <TextBlock VerticalAlignment="Center" Text="重启 AP" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnSecondary}"
                                                    x:Name="BtnWatchAuto"
                                                    Height="32"
                                                    Margin="8,0,0,0"
                                                    Padding="12,0"
                                                    AutomationProperties.Name="自动执行开关"
                                                    Click="OnWatchAuto"
                                                    Cursor="Hand"
                                                    FontSize="13.5"
                                                    ToolTip="自动执行：开=检测到假在线自己重启 AP；关=只记录不动手">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                x:Name="ImgWatchSwitch"
                                                                Width="42"
                                                                Height="22"
                                                                Margin="0,0,7,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/ui_power_24_dark.png" />
                                                            <TextBlock
                                                                x:Name="TxtWatchAuto"
                                                                VerticalAlignment="Center"
                                                                Text="自动执行：关" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnSecondary}"
                                                    x:Name="BtnDiagnose"
                                                    Height="32"
                                                    Padding="14,0"
                                                    AutomationProperties.Name="一键网络诊断"
                                                    Click="OnDiagnose"
                                                    Cursor="Hand"
                                                    FontSize="13.5"
                                                    ToolTip="逐项检查：本机地址 → 网关 → DNS → 出网 → 出口 IP → 软路由，一把定位断在哪一层">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                Width="15"
                                                                Height="15"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/ui_search_24_dark.png" />
                                                            <TextBlock VerticalAlignment="Center" Text="一键诊断" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnDanger}"
                                                    x:Name="BtnRescue"
                                                    Width="104"
                                                    Height="32"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="恢复上网"
                                                    Click="OnRescue"
                                                    Cursor="Hand"
                                                    FontSize="13.5">
                                                    
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Source="/icons/ui_power_24_red.png" /><TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="恢复上网" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnPrimary}"
                                                    x:Name="BtnRefresh"
                                                    Width="92"
                                                    Height="32"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="刷新"
                                                    Click="OnRefresh"
                                                    Cursor="Hand"
                                                    FontSize="13.5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                Width="15"
                                                                Height="15"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/ui_refresh-cw_24_white.png" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Foreground="#FFFFFFFF"
                                                                Text="刷新" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </Grid.Children>
                                </Grid>
                                <Grid Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Children>
                                        <ScrollViewer
                                            Grid.Column="0"
                                            Padding="0,0,16,0"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <StackPanel.Children>
                                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                x:Name="ImgDotLocal"
                                                                Width="12"
                                                                Height="12"
                                                                Margin="0,0,7,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/dot_wait.png" />
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="#FF2D8CFF"
                                                                Text="本机（这台 Windows）" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                    <StackPanel x:Name="StpLocal" />
                                                    <StackPanel Margin="0,12,0,4" Orientation="Horizontal">
                                                        <StackPanel.Children>
                                                            <Image
                                                                x:Name="ImgDotCampus"
                                                                Width="12"
                                                                Height="12"
                                                                Margin="0,0,7,0"
                                                                VerticalAlignment="Center"
                                                                Source="/icons/dot_wait.png" />
                                                            <TextBlock
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource TextT2}"
                                                                Text="校园网出口" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                    <StackPanel x:Name="StpCampus" />
                                                </StackPanel.Children>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <Border
                                            Grid.Column="1"
                                            Padding="18,0,0,0"
                                            BorderBrush="#FFDFE3EA"
                                            BorderThickness="1,0,0,0">
                                            <Border.Child>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <StackPanel.Children>
                                                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                                <StackPanel.Children>
                                                                    <Image
                                                                        x:Name="ImgDotMini"
                                                                        Width="12"
                                                                        Height="12"
                                                                        Margin="0,0,7,0"
                                                                        VerticalAlignment="Center"
                                                                        Source="/icons/dot_wait.png" />
                                                                    <TextBlock
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#FF2D8CFF"
                                                                        Text="远端软路由" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                            <StackPanel x:Name="StpMini" />
                                                            <Border
                                                                x:Name="BdMode"
                                                                Margin="0,14,0,0"
                                                                Padding="12,10"
                                                                Background="#FFF7FAFE"
                                                                BorderBrush="{StaticResource SurfaceChip}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                                <Border.Child>
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            FontSize="12.5"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource TextT2}"
                                                                            Text="软路由模式" />
                                                                        <TextBlock
                                                                            x:Name="TxtModeNow"
                                                                            Margin="0,4,0,8"
                                                                            FontSize="12"
                                                                            Foreground="{StaticResource TextT3}"
                                                                            Text="当前：—"
                                                                            TextWrapping="Wrap" />
                                                                        <WrapPanel>
                                                                            <Button Style="{StaticResource BtnSecondary}"
                                                                                x:Name="BtnSwitchRouter"
                                                                                Height="32"
                                                                                Padding="12,0"
                                                                                AutomationProperties.Name="切到软路由"
                                                                                Click="OnSwitchRouter"
                                                                                Cursor="Hand"
                                                                                FontSize="12.5"
                                                                                ToolTip="minipc 变成软路由：eno1 接校园网当 WAN，wlp2s0 开热点当 LAN">
                                                                                
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Image
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,6,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Source="/icons/ui_cable_24_dark.png" /><TextBlock Text="切到软路由" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Style="{StaticResource BtnDanger}"
                                                                                x:Name="BtnSwitchHotspot"
                                                                                Height="32"
                                                                                Margin="8,0,0,0"
                                                                                Padding="12,0"
                                                                                AutomationProperties.Name="回滚到热点"
                                                                                Click="OnSwitchHotspot"
                                                                                Cursor="Hand"
                                                                                FontSize="12.5"
                                                                                ToolTip="退回热点模式：关 AP、删 NAT、有线恢复 autoconnect">
                                                                                
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Image
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,6,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Source="/icons/ui_rotate-ccw_24_dark.png" /><TextBlock Foreground="#FFB91C1C" Text="回滚到热点" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Style="{StaticResource BtnSecondary}"
                                                                                x:Name="BtnHarden"
                                                                                Height="32"
                                                                                Margin="8,0,0,0"
                                                                                Padding="12,0"
                                                                                AutomationProperties.Name="加固伪装"
                                                                                Click="OnHarden"
                                                                                Cursor="Hand"
                                                                                FontSize="12.5"
                                                                                ToolTip="主机名随机化 / 关 mDNS / TTL 等加固">
                                                                                
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Image
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,6,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Source="/icons/ui_shield_24_dark.png" /><TextBlock Text="加固伪装" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </WrapPanel>
                                                                        <TextBlock
                                                                            x:Name="TxtModeHint"
                                                                            Margin="0,8,0,0"
                                                                            FontSize="11.5"
                                                                            Foreground="{StaticResource TextT3}"
                                                                            Text="切模式会断网重连：切到软路由前，主力机要先注销校园网；回滚前，主力机要先开热点。"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border.Child>
                                                            </Border>
                                                            <TextBlock
                                                                x:Name="TxtNicHint"
                                                                Margin="0,10,0,0"
                                                                FontSize="12"
                                                                Foreground="#FF2F8F5B"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,10,0,0"
                                                                Foreground="{StaticResource TextT3}"
                                                                Text="仅在本页可见时每 1 分钟刷新；离开页面即停。插了新网卡点上方「刷新」会一起查出来"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel.Children>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border.Child>
                                        </Border>
                                    </Grid.Children>
                                </Grid>
                            </Grid.Children>
                        </Grid>
                    </TabItem>
<TabItem Style="{StaticResource NavGroupLabel}" Header="网络" />
<TabItem AutomationProperties.Name="校园网">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Children>
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Source="/icons/ui_school_32_dark.png" />
                                    <TextBlock Style="{StaticResource NavText}" Text="校园网" />
                                </StackPanel.Children>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.Children>
                                <DockPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,10"
                                    LastChildFill="False">
                                    <DockPanel.Children>
                                        <Button Style="{StaticResource BtnSecondary}"
                                            x:Name="BtnCampusStatus"
                                            Height="32"
                                            Padding="14,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="查校园网状态"
                                            Click="OnCampusStatus"
                                            Cursor="Hand"
                                            DockPanel.Dock="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Children>
                                                    <Image
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Source="/icons/ui_signal_24_dark.png" />
                                                    <TextBlock VerticalAlignment="Center" Text="查状态" />
                                                </StackPanel.Children>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Source="/icons/ui_school_24_blue.png" />
                                            <TextBlock VerticalAlignment="Center"
                                            Style="{StaticResource PageTitle}"
                                            Text="校园网登录" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            FontSize="12"
                                            Foreground="{StaticResource TextT3}"
                                            Text="srun 认证 · 由 minipc 执行" />
                                    </DockPanel.Children>
                                </DockPanel>
                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Padding="16,14,16,14"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{StaticResource LineHair}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Border.Child>
                                        <StackPanel>
                                            <StackPanel.Children>
                                                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                                    <StackPanel.Children>
                                                        <TextBlock
                                                            Width="56"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            Foreground="{StaticResource TextT2}"
                                                            Text="账号" />
                                                        <TextBox
                                                            x:Name="TxtCampusUser"
                                                            Width="260"
                                                            Height="32"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="校园网账号"
                                                            ToolTip="校园网账号（学号或手机号）" />
                                                        <TextBlock
                                                            Width="56"
                                                            Margin="24,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            Foreground="{StaticResource TextT2}"
                                                            Text="密码" />
                                                        <PasswordBox
                                                            x:Name="PwdCampus"
                                                            Width="220"
                                                            Height="32"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="校园网密码" />
                                                        <TextBlock
                                                            Width="56"
                                                            Margin="24,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            Foreground="{StaticResource TextT2}"
                                                            Text="运营商" />
                                                        <ComboBox
                                                            x:Name="CmbCampusIsp"
                                                            Width="110"
                                                            Height="32"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="校园网运营商"
                                                            ToolTip="联通/移动/电信取决于你办的是哪家的校园宽带，选错门户会拒绝登录">
                                                            <ComboBox.Items>
                                                                <ComboBoxItem>中国联通</ComboBoxItem>
                                                                <ComboBoxItem>中国移动</ComboBoxItem>
                                                                <ComboBoxItem>中国电信</ComboBoxItem>
                                                                <ComboBoxItem>校园网</ComboBoxItem>
                                                                <ComboBoxItem>自定义</ComboBoxItem>
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                        <TextBox
                                                            x:Name="TxtCampusIspCustom"
                                                            Width="88"
                                                            Height="32"
                                                            Margin="8,0,0,0"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="自定义运营商域名"
                                                            ToolTip="填 srun 的域名，例如 unicom / cmcc / telecom；留空等于校园网"
                                                            Visibility="Collapsed" />
                                                        <TextBlock
                                                            Width="44"
                                                            Margin="24,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            Foreground="{StaticResource TextT2}"
                                                            Text="网卡" />
                                                        <ComboBox
                                                            x:Name="CmbCampusIf"
                                                            Width="100"
                                                            Height="32"
                                                            VerticalContentAlignment="Center"
                                                            AutomationProperties.Name="校园网网卡">
                                                            <ComboBox.Items>
                                                                <ComboBoxItem>eno1</ComboBoxItem>
                                                                <ComboBoxItem>wlp2s0</ComboBoxItem>
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Children>
                                                        <Button Style="{StaticResource BtnPrimary}"
                                                            x:Name="BtnCampusLogin"
                                                            Width="100"
                                                            Height="32"
                                                            AutomationProperties.Name="校园网登录"
                                                            Click="OnCampusLogin"
                                                            Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Children>
                                                                    <Image
                                                                        Width="15"
                                                                        Height="15"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Source="/icons/ui_cable_24_dark.png" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Foreground="#FFFFFFFF"
                                                                        Text="登录" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource BtnSecondary}"
                                                            x:Name="BtnCampusLogout"
                                                            Width="100"
                                                            Height="32"
                                                            Margin="8,0,0,0"
                                                            AutomationProperties.Name="校园网注销"
                                                            Click="OnCampusLogout"
                                                            Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Children>
                                                                    <Image
                                                                        Width="15"
                                                                        Height="15"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Source="/icons/ui_power_24_dark.png" />
                                                                    <TextBlock VerticalAlignment="Center" Text="注销" />
                                                                </StackPanel.Children>
                                                            </StackPanel>
                                                        </Button>
