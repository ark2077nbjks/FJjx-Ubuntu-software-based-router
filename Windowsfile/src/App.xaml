<Application
    x:Class="NetPanel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NetPanel">
    <Application.Resources>
        <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
            <Setter Property="TextElement.Foreground" Value="#FF1E2A3B" />
        </Style>
        <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
            <Setter Property="Control.Padding" Value="18,8" />
            <Setter Property="TextElement.FontSize" Value="14" />
        </Style>
        <Style x:Key="Mono" TargetType="{x:Type TextBlock}">
            <Setter Property="TextElement.FontFamily" Value="Consolas, 等线" />
            <Setter Property="TextElement.FontSize" Value="13.2" />
            <Setter Property="TextElement.Foreground" Value="#FF2B3A4F" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextElement.FontSize" Value="15" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="#FF23324A" />
            <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Head" TargetType="{x:Type TextBlock}">
            <Setter Property="TextElement.FontSize" Value="13" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="#FF2D8CFF" />
            <Setter Property="FrameworkElement.Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="NavText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextElement.FontSize" Value="14" />
            <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
        </Style>
        <Style x:Key="NavTab" TargetType="{x:Type TabItem}">
            <Setter Property="TextElement.Foreground" Value="#FF64738B" />
            <Setter Property="FrameworkElement.Height" Value="46" />
            <Setter Property="FrameworkElement.Margin" Value="8,2,8,2" />
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border
                            x:Name="Bd"
                            Padding="14,0,10,0"
                            Background="#00FFFFFF"
                            CornerRadius="8">
                            <Border.Child>
                                <Grid>
                                    <Grid.Children>
                                        <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
                                        <Rectangle
                                            x:Name="Accent"
                                            Width="3"
                                            Height="20"
                                            Margin="-14,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Fill="#00FFFFFF"
                                            RadiusX="1.5"
                                            RadiusY="1.5" />
                                    </Grid.Children>
                                </Grid>
                            </Border.Child>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TabItem.IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Panel.Background" Value="#FFE8F3FF" />
                                <Setter TargetName="Accent" Property="Shape.Fill" Value="#FF2D8CFF" />
                                <Setter Property="TextElement.Foreground" Value="#FF2D8CFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                                    <Condition Property="TabItem.IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Panel.Background" Value="#FFF2F7FE" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="172" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Children>
                                <Border
                                    Padding="0,10"
                                    Background="#FFF7FAFE"
                                    BorderBrush="#FFE9EFF7"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Child>
                                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                    </Border.Child>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="16"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FFE9EFF7"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Child>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                    </Border.Child>
                                </Border>
                            </Grid.Children>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
