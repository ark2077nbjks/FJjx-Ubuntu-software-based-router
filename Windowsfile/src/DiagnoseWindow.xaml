<Window x:Class="NetPanel.DiagnoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络诊断" Height="620" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="一键网络诊断" FontSize="16" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" AutomationProperties.Name="取消诊断" Height="32" Margin="0,0,8,0" Padding="14,0"
                        Click="OnCancel" Background="#EEF2F8" BorderThickness="1" BorderBrush="#D5DBE5" Cursor="Hand" Visibility="Collapsed">
                    <TextBlock Text="取消"/>
                </Button>
                <Button x:Name="BtnRerun" AutomationProperties.Name="重新诊断" Height="32" Padding="14,0"
                        Click="OnRerun" Background="#EEF2F8" BorderThickness="1" BorderBrush="#D5DBE5" Cursor="Hand">
                    <TextBlock Text="重新诊断"/>
                </Button>
                <Button x:Name="BtnCopy" AutomationProperties.Name="复制结果" Height="32" Margin="8,0,0,0" Padding="14,0"
                        Click="OnCopy" Background="#EEF2F8" BorderThickness="1" BorderBrush="#D5DBE5" Cursor="Hand">
                    <TextBlock Text="复制结果"/>
                </Button>
                <Button AutomationProperties.Name="关闭" Height="32" Margin="8,0,0,0" Padding="14,0"
                        Click="OnClose" Background="#2F6FED" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="关闭" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="VerdictBox" Background="White" BorderBrush="#E4E8EF" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtVerdict" Text="正在检查…" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#1F2937" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSub" Text="" Margin="0,4,0,0" FontSize="12" Foreground="#7C8798" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4E8EF" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,8">
                <StackPanel x:Name="PanelItems"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="TxtFoot" Margin="2,10,0,0" FontSize="11.5" Foreground="#9AA5B4"
                   TextWrapping="Wrap"
                   Text="只做只读探测：ping、DNS 查询、HTTP 204、取出口 IP、远端 ssh 只读命令。不改任何配置，不发多余流量。"/>
    </Grid>
</Window>
