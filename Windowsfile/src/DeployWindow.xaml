<Window x:Class="NetPanel.DeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键部署"
        Width="620" Height="760"
        MinWidth="560" MinHeight="620"
        Background="#FFF5F7FA"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="一键部署" FontSize="19" FontWeight="SemiBold" Foreground="#FF1B2434" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#FF7C8798" TextWrapping="Wrap"
                       Text="把 Ubuntu 变成软路由：上传 → 安装 → 自检，全程不用碰终端。密码只在本机内存里，不存盘。" />
        </StackPanel>

        <Border Grid.Row="1" Padding="14" Background="White" BorderBrush="#FFE3E8EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="目标" Foreground="#FF5A6474" />
                <TextBox x:Name="TxtHost" Grid.Column="1" Height="32" Margin="10,0,0,0" Padding="8,0"
                         VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />
                <TextBlock Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center" Text="用户" Foreground="#FF5A6474" />
                <TextBox x:Name="TxtUser" Grid.Column="3" Height="32" Padding="8,0"
                         VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14" Background="White" BorderBrush="#FFE3E8EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="拓扑" Foreground="#FF5A6474" />
                <ComboBox x:Name="CmbTopo" Grid.Row="0" Grid.Column="1" Height="32" Margin="0,0,10,0"
                          VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5">
                    <ComboBoxItem Content="A · 无线当 LAN（推荐）" Tag="A" />
                    <ComboBoxItem Content="C · 有线 USB 网卡当 LAN" Tag="C" />
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="热点名" Foreground="#FF5A6474" />
                <TextBox x:Name="TxtSsid" Grid.Row="0" Grid.Column="3" Height="32" Padding="8,0"
                         VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="热点密码" Foreground="#FF5A6474" />
                <PasswordBox x:Name="PwWifi" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,10,0" Padding="8,0"
                             VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />

                <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,10,0,0" VerticalAlignment="Center" Text="LAN 网关" Foreground="#FF5A6474" />
                <TextBox x:Name="TxtLanIp" Grid.Row="1" Grid.Column="3" Height="32" Margin="0,10,0,0" Padding="8,0"
                         VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" FontSize="11"
                           Foreground="#FF7C8798" TextWrapping="Wrap"
                           Text="热点密码至少 8 位；LAN 网关被占用时安装脚本会自动换一个。" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="14" Background="White" BorderBrush="#FFE3E8EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="SSH 密码" Foreground="#FF5A6474" />
                <PasswordBox x:Name="PwSsh" Grid.Column="1" Height="32" Margin="0,0,10,0" Padding="8,0"
                             VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="sudo 密码" Foreground="#FF5A6474" />
                <PasswordBox x:Name="PwSudo" Grid.Column="3" Height="32" Padding="8,0"
                             VerticalContentAlignment="Center" Background="#FFF8FAFD" BorderBrush="#FFD5DBE5" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="ChkDry" VerticalAlignment="Center" Foreground="#FF5A6474"
                      Content="演练模式（只检查不真装，用来验证链路）" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnStart" Width="132" Height="34" Padding="12,0" BorderThickness="0"
                        Background="#FF2F6FED" Foreground="White" Cursor="Hand" Click="OnStart"
                        Content="开始部署" />
                <Button x:Name="BtnClose" Width="88" Height="34" Margin="8,0,0,0" Padding="12,0"
                        Background="#FFEEF2F8" BorderBrush="#FFD5DBE5" BorderThickness="1" Cursor="Hand"
                        Content="关闭" Click="OnClose" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <Grid>
                <TextBlock x:Name="TxtStep" FontSize="12" Foreground="#FF5A6474" Text="待开始" />
                <TextBlock x:Name="TxtPct" HorizontalAlignment="Right" FontSize="12" Foreground="#FF7C8798" Text="" />
            </Grid>
            <ProgressBar x:Name="PbStep" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="7" Value="0"
                         Background="#FFEDF1F7" Foreground="#FF2F6FED" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="6" Margin="0,12,0,0" Padding="2" Background="#FF0F1723" CornerRadius="8">
            <TextBox x:Name="TxtLog" Margin="6" Background="Transparent" BorderThickness="0"
                     Foreground="#FFB9C6D8" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
